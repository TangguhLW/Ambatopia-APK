extends RefCounted
func run(t) -> void:
	var path="res://src/game/guild_weather.gd"
	t.check(ResourceLoader.exists(path),"Guild weather has a dedicated mascot model")
	if not ResourceLoader.exists(path):return
	var G=load(path)
	var W=load("res://src/game/world_state.gd");var P=load("res://src/game/player_state.gd");var R=load("res://src/game/item_runtime.gd")
	var Lock=load("res://src/game/lock_rules.gd")
	var w=W.new();w.create_default("GUILD031")
	var p=P.new();p.actor_key="owner";p.position=Vector2(48*32+16,24*32)
	var r=R.new();var machine:=Vector2i(49,23);var lock_tile:=Vector2i(47,23)
	var placement=load("res://src/game/interactions.gd").new()
	t.check(not placement.apply(w,p,"place",Vector2i(49,22),206280).accepted,"Guild weather placement requires an actual Guild Lock")
	w.set_tile(machine,206280)
	t.check(not r.interact(w,p,machine,"activate",{}).accepted and w.weather=="sunny","Guild weather rejects a world without Guild Lock")
	w.set_tile(lock_tile,105814);Lock.placed(w,lock_tile,105814,p.actor_key)
	t.check(not placement.apply(w,p,"place",Vector2i(49,22),105814).accepted,"A second world-wide Guild Lock cannot be placed")
	t.check(not r.interact(w,p,machine,"activate",{}).accepted,"An unconfigured guild does not display a generic mascot")
	t.check(r.interact(w,p,lock_tile,"configure",{"mascot_fg":2,"mascot_bg":14}).accepted,"Guild Lock owner can choose actual foreground/background mascot items")
	var guest=P.new();guest.actor_key="guest";guest.position=p.position
	t.check(not r.interact(w,guest,lock_tile,"configure",{"mascot_fg":8,"mascot_bg":14}).accepted,"Guest cannot change guild mascot")
	var before: Dictionary=w.extras.duplicate(true)
	for args in [{"mascot_fg":14,"mascot_bg":14},{"mascot_fg":2,"mascot_bg":2},{"mascot_fg":34,"mascot_bg":14},{"mascot_fg":2.5,"mascot_bg":14},{"mascot_fg":-1,"mascot_bg":14},{"mascot_fg":2,"mascot_bg":14,"owner":"guest"}]:
		t.check(not r.interact(w,p,lock_tile,"configure",args).accepted and w.extras==before,"Invalid mascot metadata does not change guild settings")
	t.check(r.interact(w,p,machine,"activate",{}).accepted and w.weather=="guild","A valid Guild-Locked world activates Guild weather")
	t.check(r.interact(w,p,machine,"configure",{"gravity":-50,"spin":true,"invert":true}).accepted,"Guild weather saves the three controls shown in original wrench screenshot")
	var params: Dictionary=G.parameters(w,r.state(w,machine))
	t.check(params.mascot_fg==2 and params.mascot_bg==14 and params.gravity==-50 and params.spin and params.invert,"Weather always inherits its Guild Lock mascot rather than an independent item selector")
	var restored=W.new()
	t.check(restored.restore(w.serialize()) and G.parameters(restored,params).mascot_fg==2,"Guild mascot persists in the world save")
	t.check(r.interact(w,p,lock_tile,"configure",{"mascot_fg":8,"mascot_bg":0}).accepted and G.parameters(w,params).mascot_fg==8,"Changing guild mascot updates active weather; foreground-only option works in creative mode")
	var Rules=load("res://src/game/source_machine_rules.gd")
	Rules.removed(w,6280,machine)
	t.check(w.weather=="sunny","Removing Guild weather restores prior sky")
	r.interact(w,p,machine,"activate",{})
	w.set_tile(lock_tile,0);Rules.tick(r,w)
	t.check(w.weather=="sunny","A stale/removed Guild Lock stops its weather instead of leaving invalid mascot rain")
	var plan: Array=G.particles(Vector2(830,830),1.0,{"gravity":50,"spin":false},false)
	t.check(plan.size()<=48 and plan.size()>=20 and plan.all(func(row):return row.rect.size.x>0 and row.rect.size.x<=110 and row.angle==0),"Guild particles use bounded reference-sized mascot images, not dots")
	var up: Array=G.particles(Vector2(830,830),1.1,{"gravity":-50,"spin":false},false)
	var down: Array=G.particles(Vector2(830,830),1.1,{"gravity":50,"spin":true},false)
	t.check(up[0].rect.position!=down[0].rect.position and down[0].angle!=0,"Reverse gravity and spin change actual particle trajectories")
	t.check(G.particles(Vector2(830,830),1792860000.0,{"spin":true},false).all(func(row):return absf(row.angle)<TAU),"Shared-clock spin angles stay bounded and smooth")
	var A=load("res://src/game/interactions.gd").new();w.create_default("LOCK031")
	w.set_tile(lock_tile,105814);Lock.placed(w,lock_tile,105814,p.actor_key)
	A.apply(w,p,"punch",lock_tile,0)
	t.check(w.tile_at(lock_tile)==105814 and not w.damage.has(lock_tile),"Ordinary owner cannot punch-break permanent Guild Lock")
	var safe: Dictionary=G.parameters(w,{"gravity":{},"spin":"yes","invert":12})
	t.check(safe.is_empty(),"Malformed imported mascot settings do not create a fabricated mascot")
	var findings: Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://research/guild-starship-031/starship-findings.json"))
	var Blast=load("res://src/game/source_blasts.gd")
	w.create_default("STARSHIP031")
	var original: Dictionary=w.serialize().duplicate(true)
	for ship in findings.ships:
		t.check(not ship.layout_recovered and not Blast.available(int(ship.id)),"Unrecovered original Starship layout is not counted as implemented: "+str(ship.id))
		t.check(not Blast.apply(r,w,p,Vector2i(49,23),int(ship.id)).accepted and w.serialize()==original,"Using an unrecovered Starship preserves the world: "+str(ship.id))
	w.set_tile(lock_tile,105814);w.locks=[{"x":lock_tile.x,"y":lock_tile.y,"area":0,"item":105814}]
	t.check(G.record(w).is_empty(),"An imported Guild Lock without an owner is not treated as a valid guild")
	var core=load("res://src/network/room_server.gd").new()
	core.join(1,"Owner","GUILDNET");core.join(2,"Guest","GUILDNET")
	var room: Dictionary=core.rooms.GUILDNET;room.owner=1
	room.world.set_tile(lock_tile,105814);Lock.placed(room.world,lock_tile,105814,core.players[1].state.actor_key)
	room.world.set_tile(machine,206280)
	for id in [1,2]:core.players[id].state.position=Vector2(48*32+16,24*32)
	t.check(core.accept(1,{"type":"machine","x":lock_tile.x,"y":lock_tile.y,"command":"configure","args":{"mascot_fg":22,"mascot_bg":14}}),"Authoritative room accepts Guild owner mascot configuration")
	t.check(not core.accept(2,{"type":"machine","x":lock_tile.x,"y":lock_tile.y,"command":"configure","args":{"mascot_fg":2,"mascot_bg":14}}),"Authoritative room rejects guest mascot changes")
	core.players[1].actions.tick(0.3)
	t.check(core.accept(1,{"type":"machine","x":machine.x,"y":machine.y,"command":"activate","args":{}}) and room.world.weather=="guild","Authoritative room activates valid Guild weather")
