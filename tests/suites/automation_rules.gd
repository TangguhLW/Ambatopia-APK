extends RefCounted
const World=preload("res://src/game/world_state.gd")
const Player=preload("res://src/game/player_state.gd")
func run(t) -> void:
	if not ResourceLoader.exists("res://src/game/automation_items.gd"):
		t.check(false,"Recovered Crystal/Xenonite/MAGPLANT/Gaia runtime must exist")
		return
	var r=load("res://src/game/item_runtime.gd").new()
	var w=World.new();w.create_default("AUTOTEST")
	var p=Player.new();p.position=Vector2(48*32+16,24*32)
	var at=Vector2i(49,23)
	w.set_tile(at,202242);r.planted(w,at,2242)
	t.check(r.automation.add_crystal(r,w,at,2248).accepted,"Crystal cluster accepts another crystal")
	for i in 3:r.automation.add_crystal(r,w,at,2248)
	t.check(not r.automation.add_crystal(r,w,at,2244).accepted,"Crystal cluster stops at five crystals")
	var data=r.state(w,at)
	t.check(data.crystals["2242"]==1 and data.crystals["2248"]==4,"Cluster records actual color counts")
	data.crystals={"2242":2,"2248":3};data.erase("chi_required")
	var recipe=r.automation.crystal_recipe(r,data)
	t.check(recipe.size()==7 and int(recipe[5])==2254,"Crystal mix chooses recovered highest-rarity matching recipe")
	var required=r.automation.crystal_requirement(r,data)
	t.check(required.reduce(func(a,b):return a+b,0)>=3,"Crystal alignment generates persistent source Chi requirement")
	data.chi_required=[0,0,0,0]
	for dy in range(-1,2):
		for dx in range(-1,2):
			var tile=at+Vector2i(dx,dy)
			if tile!=at:w.set_tile(tile,0)
			w.background[tile.y*w.size.x+tile.x]=0
	var prize=r.automation.punch(r,w,p,at)
	t.check(prize.accepted and w.tile_at(at)==0 and w.drops.back().id==2254,"Aligned cluster shatters into exact recipe output")
	w.set_tile(at,202242);r.planted(w,at,2242)
	data=r.state(w,at);data.crystals={"2242":2,"2248":3};data.chi_required=[1,0,0,0]
	t.check(not r.automation.punch(r,w,p,at).accepted and w.tile_at(at)==202242,"Wrong Chi prevents shattering and preserves crystals")
	w.set_tile(at+Vector2i.LEFT,1)
	t.check(r.automation.chi_at(r,w,at)[0]==1,"Dirt contributes Earth Chi from recovered element table")
	w.extras.clear();w.set_tile(at,202072);r.planted(w,at,2072)
	var xen=r.interact(w,p,at,"xenonite",{"power":"dbl","mode":"force"})
	t.check(xen.accepted,"Xenonite saves world power setting")
	p.world_rules=w.world_effects.get("xenonite",{})
	t.check(p.can_double_jump(),"Forced Double Jump works without clothing")
	r.interact(w,p,at,"xenonite",{"power":"dbl","mode":"block"})
	p.equip_catalog(156)
	t.check(not p.can_double_jump(),"Blocked Double Jump overrides equipped wings")
	t.check(not r.interact(w,p,at,"xenonite",{"power":"developer","mode":"force"}).accepted,"Xenonite cannot set invented privileged fields")
	r.interact(w,p,at,"xenonite",{"power":"pwr","mode":"block"})
	t.check(not r.use_item(w,p,at,274).accepted,"Block Powerups prevents consumable modifier use")
	r.automation.removed(r,w,at,2072)
	p.world_rules=w.world_effects.get("xenonite",{})
	t.check(p.can_double_jump(),"Removing Xenonite restores equipment powers")
	w.create_default("MAGTEST");w.set_tile(at,205638);r.planted(w,at,5638)
	p.position=Vector2(48*32+16,24*32)
	t.check(r.interact(w,p,at,"select_target",{"item":2}).accepted,"MAGPLANT selects one compatible item type")
	r.reward(w,Vector2i(80,10),2,8)
	r.automation.tick(r,w,0.5)
	data=r.state(w,at)
	t.check(data.count==8 and w.drops.is_empty(),"MAGPLANT collects matching objects from entire world every half-second")
	t.check(not r.interact(w,p,at,"select_target",{"item":10}).accepted,"Nonempty MAGPLANT refuses item change")
	r.interact(w,p,at,"configure",{"enabled":false})
	r.reward(w,Vector2i(80,10),2,2);r.automation.tick(r,w,0.5)
	t.check(data.count==8 and w.drops.size()==1,"Disabled collection leaves floating objects untouched")
	r.interact(w,p,at,"configure",{"enabled":true})
	data.count=4999;r.automation.tick(r,w,0.5)
	t.check(data.count==5000 and w.drops[0].amount==1,"MAGPLANT capacity keeps overflow in world")
	r.interact(w,p,at,"activate",{})
	t.check(data.building and not p.machine_remote.is_empty(),"Punch/activation enables MAGPLANT building and binds player remote")
	var actions=load("res://src/game/interactions.gd").new()
	var target=Vector2i(48,22)
	var placed=actions.apply(w,p,"place",target,205640)
	t.check(placed.accepted and r.source(w.tile_at(target))==2 and data.count==4999,"Remote builds selected block and subtracts exactly one stored item")
	actions.cooldown=0
	var failed=actions.apply(w,p,"place",target,205640)
	t.check(not failed.accepted and data.count==4999,"Failed remote placement never consumes stock")
	w.create_default("GAIATEST");w.set_tile(at,206946);r.planted(w,at,6946)
	t.check(not r.interact(w,p,at,"select_target",{"item":2}).accepted,"Gaia Beacon rejects blocks")
	t.check(r.interact(w,p,at,"select_target",{"item":3}).accepted,"Gaia Beacon accepts seeds")
	r.reward(w,Vector2i(70,10),3,5);r.automation.tick(r,w,0.5)
	t.check(r.state(w,at).count==5,"Gaia Beacon collects matching floating seeds")
	w.extras.clear();w.drops.clear();w.set_tile(at,206950);r.planted(w,at,6950)
	r.interact(w,p,at,"select_target",{"item":2})
	r.interact(w,p,at,"refuel",{"amount":8001})
	r.interact(w,p,at,"activate",{})
	var tree=Vector2i(80,23);w.set_tile(tree,200003);r.planted(w,tree,3)
	r.state(w,tree).planted=r.now()-100
	r.automation.tick(r,w,1.5)
	data=r.state(w,at)
	t.check(w.tile_at(tree)==0 and not w.drops.is_empty() and data.fuel==7999,"Heart of Gaia harvests a matching mature tree and spends one fuel per source tick")
	var saved=World.new()
	t.check(saved.restore(w.serialize()) and saved.extras[r.key(w,at)].fuel==7999,"Gaia target, enabled state and fuel persist across rejoin")

	w.create_default("SECUREAUTO");w.set_tile(at,205638);r.planted(w,at,5638)
	r.interact(w,p,at,"select_target",{"item":2})
	r.interact(w,p,at,"deposit",{"item":2,"amount":5000})
	t.check(r.state(w,at).count==5000,"Creative MAGPLANT deposits use its real capacity instead of generic 200 stock")
	var before=r.state(w,at).duplicate(true)
	t.check(not r.interact(w,p,at,"configure",{"enabled":{}}).accepted,"Malformed collection switch fails closed")
	t.check(not r.interact(w,p,at,"deposit",{"item":2,"amount":-3}).accepted,"Negative automation stock cannot mint items")
	t.check(r.state(w,at).count==before.count,"Rejected stock input preserves machine count")
	r.state(w,at).count=0
	r.reward(w,Vector2i(80,10),2,7)
	w.locks=[{"area":1,"owner":"other","tiles":[1080],"x":80,"y":10}]
	r.automation.tick(r,w,0.5)
	t.check(r.state(w,at).count==0 and w.drops[0].amount==7,"World-wide collector cannot steal floating items inside another account's area lock")
	w.locks.clear()
	r.automation.tick(r,w,0.5)
	t.check(r.state(w,at).count==7,"Collector resumes when target objects are accessible")
	p.collected["2"]=199
	r.interact(w,p,at,"withdraw",{"amount":200})
	t.check(p.collected["2"]==200 and r.state(w,at).count==6,"Retrieval obeys 200-item stack and conserves stored remainder")
	r.interact(w,p,at,"activate",{})
	w.locks=[{"area":0,"owner":"other","tiles":[],"x":50,"y":22}]
	t.check(not r.automation.remote_target(r,w,p).accepted,"Remote cannot access a machine covered by another owner's lock")
	w.locks.clear()
	t.check(not r.automation.punch(r,w,p,at).is_empty(),"A stocked MAGPLANT punch changes mode instead of destroying stock")
	w.create_default("HEARTSECURE");w.set_tile(at,206950);r.planted(w,at,6950)
	r.interact(w,p,at,"select_target",{"item":2})
	r.interact(w,p,at,"refuel",{"amount":10})
	r.interact(w,p,at,"activate",{})
	tree=Vector2i(80,23);w.set_tile(tree,200003);r.planted(w,tree,3)
	r.state(w,tree).planted=r.now()-100
	w.locks=[{"area":1,"owner":"other","tiles":[2380],"x":80,"y":23}]
	r.automation.tick(r,w,1.5)
	t.check(w.tile_at(tree)==200003 and r.state(w,at).fuel==10,"Heart of Gaia respects another owner's tree and preserves fuel")
	w.locks.clear();r.state(w,tree).planted=r.now()
	r.automation.tick(r,w,1.5)
	t.check(w.tile_at(tree)==200003 and r.state(w,at).fuel==10,"Unripe tree remains planted and consumes no harvest fuel")
	r.state(w,tree).planted=r.now()-100;r.state(w,at).fuel=0
	r.automation.tick(r,w,1.5)
	t.check(w.tile_at(tree)==200003,"Unfueled Gaia cannot harvest")
	w.set_tile(at,202072);w.extras.erase(r.key(w,at));r.planted(w,at,2072)
	for power in ["hig","asb","pun","lng","spd","lngb","siw","sp2"]:
		t.check(r.interact(w,p,at,"xenonite",{"power":power,"mode":"force"}).accepted,"Xenonite supports recovered power: "+power)
	t.check(p.abilities().jump>1 and p.abilities().fireproof and p.abilities().dig==2 and p.abilities().build_range==128,"Xenonite changes jump, lava resistance, punch damage and build reach")
	var moves=load("res://src/game/simulation.gd").new()
	p.position=Vector2(48*32+16,24*32);p.grounded=true
	moves.step(w,p,{"axis":1,"jump_pressed":true},1.0/60)
	t.check(p.velocity.x>150 and p.velocity.y<-390,"Forced high jump and speed drive actual simulation")
	var actions2=load("res://src/game/interactions.gd").new()
	p.position=Vector2(48*32+16,24*32)
	for i in 60:
		actions2.cooldown=0
		actions2.apply(w,p,"punch",at,0)
		if w.tile_at(at)==0:break
	t.check(not w.world_effects.has("xenonite"),"Breaking Xenonite clears world rules through actual punch action")
	var core=load("res://src/network/room_server.gd").new()
	core.join(1,"Owner","AUTONET",{"id":"owner","role":"player"})
	core.join(2,"Guest","AUTONET",{"id":"guest","role":"player"})
	var room=core.rooms.AUTONET
	room.world.set_tile(at,202072);r.planted(room.world,at,2072)
	room.owner=1;room.owner_uid="owner"
	t.check(not core.accept(2,{"type":"machine","x":49,"y":23,"command":"xenonite","args":{"power":"dbl","mode":"force"}}),"Nonowner cannot change a locked world's powers")
	t.check(core.accept(1,{"type":"machine","x":49,"y":23,"command":"xenonite","args":{"power":"dbl","mode":"force"}}),"Verified owner can configure world powers")
	core.step(1.0/60)
	t.check(core.players[1].state.can_double_jump() and core.players[2].state.can_double_jump(),"World power applies to every player on authoritative server")
	t.check(core.events.any(func(event):return event.type=="world_rules"),"World power configuration publishes a dedicated synchronization event")

	w.create_default("TESSERACT")
	w.set_tile(at,206952);r.planted(w,at,6952)
	p.position=Vector2(48*32+16,24*32)
	r.interact(w,p,at,"select_target",{"item":2})
	r.interact(w,p,at,"refuel",{"amount":20})
	r.interact(w,p,at,"activate",{})
	r.automation.tick(r,w,1.5)
	t.check(w.tile_at(Vector2i(0,24))==1 and r.state(w,at).hit_points==17,"Tesseract uses source hits field (18 for Dirt), not sprite health style")
	t.check(not r.automation.compatible(r,36,5638),"MAGPLANT rejects ordinary clothing under source compatibility predicate")
	t.check(r.automation.compatible(r,4,5638),"MAGPLANT accepts source Lava despite its special action type")
